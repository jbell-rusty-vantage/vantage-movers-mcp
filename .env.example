# Required on the deployed MCP server and for local `pnpm dev`.
# Agents must also send this same value in MCP client headers.
VANTAGE_API_SECRET=

# Optional. Defaults to the production Granot / Vantage API.
VANTAGE_API_BASE_URL=https://vantage-movers-main-server.vercel.app

# Required for the dedicated MongoDB tools. Same Atlas URI the main server uses.
MONGO_URI=

# Optional. Defaults to vantagemovers, or testvantagemovers when TEST_MODE=true.
# MONGO_DATABASE_NAME=vantagemovers

# Optional. Set true only when you intentionally want the test database name.
# TEST_MODE=false
